# SpacetimeDB connection (the local dev server)
STDB_URI=ws://127.0.0.1:3050
STDB_DB=builders-rpg

# LLM — OpenAI-compatible. Leave LLM_API_KEY blank to run in offline MOCK mode.
#
# Option A — Kilo Gateway (recommended: Gemini 2.5 Flash, fast + smart, 0% markup):
#   LLM_BASE_URL=https://api.kilo.ai/v1        # confirm exact base URL in your Kilo dashboard
#   LLM_API_KEY=sk-kilo-...
#   LLM_MODEL=gemini-2.5-flash
#
# Option B — OpenAI directly:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o            # or gpt-4.1-mini / gpt-5-mini
#
# Planner can use a stronger model (optional). Falls back to LLM_MODEL.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_PLANNER_MODEL=
